# Replace with the hostname covered by your TLS certificate.
HARBOR_HOST=harbor.example.ts.net
# Use your private/Tailscale IPv4 address for access from other devices.
# Loopback is the safe default. Do not bind to a public interface.
HARBOR_BIND_IP=127.0.0.1
COMPOSE_PROJECT_NAME=harbor
DOCKER_SOCKET=/var/run/docker.sock
# Optional comma-separated Docker network names for maintain.py.
# Empty means all non-internal user-defined bridge networks.
HARBOR_ATTACH_NETWORKS=
